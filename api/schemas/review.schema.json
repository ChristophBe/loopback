{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ChristophBe/loopback/api/schemas/review.schema.json",
  "title": "Bad-code review exercise",
  "type": "object",
  "required": ["id", "type", "language", "project", "title", "code", "flaggedLines"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": { "const": "review" },
    "language": { "enum": ["go", "rust"] },
    "project": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "code": {
      "type": "object",
      "required": ["language", "source"],
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["go", "rust"] },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "flaggedLines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["line", "note"],
        "additionalProperties": false,
        "properties": {
          "line": { "type": "integer", "minimum": 1, "description": "One-based line number in code.source." },
          "note": { "type": "string", "minLength": 1, "description": "What is wrong and what to do." }
        }
      }
    }
  }
}
