{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ChristophBe/loopback/api/schemas/quiz.schema.json",
  "title": "Quiz exercise",
  "type": "object",
  "required": ["id", "type", "language", "project", "title", "questions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": { "const": "quiz" },
    "language": { "enum": ["go", "rust"] },
    "project": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prompt", "choices", "answer", "explanation"],
        "additionalProperties": false,
        "properties": {
          "prompt": { "type": "string", "minLength": 1 },
          "choices": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "answer": { "type": "integer", "minimum": 0, "description": "Zero-based index into choices." },
          "explanation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
